<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Route static assets (like storage, build, images, assets) to the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(storage|build|images|assets)/(.*)$ public/$1/$2 [L,NC]

    # Direct all requests to public/index.php, except for actual files or directories
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ public/index.php [L]
    
    # Handle the root of the subfolder directory
    RewriteRule ^$ public/index.php [L]
</IfModule>
