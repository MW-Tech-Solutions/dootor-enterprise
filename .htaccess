<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Direct all requests to public/index.php, except for actual files or directories
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ public/index.php [L]
    
    # Handle the root of the subfolder directory
    RewriteRule ^$ public/index.php [L]
</IfModule>
